VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — set these in Vercel's Environment Variables (not as VITE_*),
# never in client-bundled config.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# Resend (transactional email) — server-only, used by api/email.js
RESEND_API_KEY=
# Optional. Defaults to onboarding@resend.dev (no domain setup required, but
# Resend restricts recipients until you verify a domain). Once joinmellow.xyz
# is verified in Resend, set this to e.g. "Mellow <hello@joinmellow.xyz>".
RESEND_FROM=
