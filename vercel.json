{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/jobs/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-role?slug=:slug"
    },
    {
      "source": "/company/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-company?slug=:slug"
    },
    {
      "source": "/profile/:username",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-profile?username=:username"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/welcome-email-nudge", "schedule": "0 5 * * *" },
    { "path": "/api/cron/profile-view-digest", "schedule": "0 15 * * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "0 6 * * 0" },
    { "path": "/api/cron/work-video-nudge", "schedule": "0 7 * * *" },
    { "path": "/api/cron/video-reminder", "schedule": "0 8 * * *" },
    { "path": "/api/cron/meeting-follow-up", "schedule": "0 9 * * *" }
  ]
}
