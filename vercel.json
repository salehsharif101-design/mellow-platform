{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/jobs",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-jobs-index"
    },
    {
      "source": "/jobs/:location(bahrain|uae|saudi-arabia)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-jobs-location?location=:location"
    },
    {
      "source": "/hire",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-hire-index"
    },
    {
      "source": "/hire/:location/:role",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-hire-role?location=:location&role=:role"
    },
    {
      "source": "/jobs/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-role?slug=:slug"
    },
    {
      "source": "/company/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-company?slug=:slug"
    },
    {
      "source": "/profile/:username",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|redditbot|Googlebot|Applebot|Pinterest|vkShare|SkypeUriPreview|Iframely).*" }],
      "destination": "/api/og-profile?username=:username"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/email-illustrations/(Client_to_creative.png|Easy_stuff.png|Collaborate2.png|Flexible.PNG|Quality.PNG|thinking2.png|connection.png|Your_Requested_Is_Posted.png|working.png|Floating girl.PNG)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(Email_Verification.png|Email_Verification3.png|mellow_logofont_email_blue.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/welcome-email-nudge", "schedule": "0 5 * * *" },
    { "path": "/api/cron/profile-view-digest", "schedule": "0 15 * * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "0 6 * * 0" },
    { "path": "/api/cron/work-video-nudge", "schedule": "0 7 * * *" },
    { "path": "/api/cron/video-reminder", "schedule": "0 8 * * *" },
    { "path": "/api/cron/meeting-follow-up", "schedule": "0 9 * * *" },
    { "path": "/api/cron/video-question-reminder", "schedule": "0 * * * *" },
    { "path": "/api/cron/post-hire-nudge", "schedule": "0 11 * * *" },
    { "path": "/api/cron/onboarding-dropoff-nudge", "schedule": "0 12 * * *" },
    { "path": "/api/cron/employer-onboarding-dropoff-nudge", "schedule": "0 13 * * *" }
  ]
}
